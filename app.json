{
  "expo": {
    "name": "Peace and Learn",
    "slug": "peace-and-learn",
    "version": "0.2.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.peaceandlearn.app"
    },
    "ios": {
      "bundleIdentifier": "com.peaceandlearn.app"
    },
    "plugins": [
      "expo-sqlite",
      [
        "llama.rn",
        { "enableOpenCL": true, "forceCxx20": true }
      ],
      [
        "expo-build-properties",
        { "android": { "minSdkVersion": 26 } }
      ]
    ]
  }
}
